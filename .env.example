# ─── AMESCOTES ERP 환경변수 ───
# 로컬: 이 파일을 .env 로 복사 후 값 채우기
# 배포(Railway 등): 아래 값들을 플랫폼 환경변수 화면에 그대로 입력
# ─── 데이터 계층 (셀프호스팅 Postgres + PostgREST) ───
# Postgres / PostgREST (docker-compose)
POSTGRES_PASSWORD=change_me
PGRST_AUTHENTICATOR_PASSWORD=change_me
PGRST_JWT_SECRET=change_me_64_hex_chars

# Anthropic (OCR / AI 어시스턴트용) — 서버에서 사용
ANTHROPIC_API_KEY=sk-ant-...

# ─── 공개 배포 접근 보호 (외부 URL 공유 시 필수) ───
# SHARE_PASS 를 설정하면 사이트 접속 시 브라우저 비밀번호 창이 뜸.
# 로컬/사내 LAN 에서는 비워두면 게이트 없음.
SHARE_USER=atlm
SHARE_PASS=

# 로컬 실행 포트 (배포 플랫폼은 자동으로 PORT 주입 → 아래 무시됨)
PORT=4000

# ─── Docker/Caddy 배포용 (EC2) ───
# Caddy가 서빙할 주소. 도메인 연결 후 예: erp.atlm.kr (Let's Encrypt 자동 HTTPS)
# 도메인 연결 전 임시 운영은 :80 (HTTP)
SITE_ADDRESS=:80
