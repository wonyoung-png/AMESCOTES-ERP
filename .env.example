# ─── AMESCOTES ERP 환경변수 ───
# 로컬: 이 파일을 .env 로 복사 후 값 채우기
# 배포(Railway 등): 아래 값들을 플랫폼 환경변수 화면에 그대로 입력
# ─── 데이터 계층 (셀프호스팅 Postgres + PostgREST) ───
# Postgres / PostgREST (docker-compose)
POSTGRES_PASSWORD=change_me
PGRST_AUTHENTICATOR_PASSWORD=change_me
PGRST_JWT_SECRET=change_me_64_hex_chars

# Anthropic (OCR / AI 어시스턴트용) — 서버에서 사용
ANTHROPIC_API_KEY=sk-ant-...

# ─── 공개 배포 접근 보호 (외부 URL 공유 시 필수) ───
# SHARE_PASS 를 설정하면 사이트 접속 시 브라우저 비밀번호 창이 뜸.
# 로컬/사내 LAN 에서는 비워두면 게이트 없음.
SHARE_USER=atlm
SHARE_PASS=

# 로컬 실행 포트 (배포 플랫폼은 자동으로 PORT 주입 → 아래 무시됨)
PORT=4000

# ─── Docker/Caddy 배포용 (EC2) ───
# Caddy가 서빙할 주소. 도메인 연결 후 예: erp.atlm.kr (Let's Encrypt 자동 HTTPS)
# 도메인 연결 전 임시 운영은 :80 (HTTP)
SITE_ADDRESS=:80

# LUMEN 상품 등록 — 운영 검수 전에는 외부 쓰기를 켜지 않습니다.
PRODUCT_REGISTRATION_WRITES_ENABLED=false
# ERP 전용 Cafe24 앱만 사용합니다. 기존 MCP 앱의 refresh token을 공유하지 않습니다.
CAFE24_ERP_CLIENT_ID=
CAFE24_ERP_CLIENT_SECRET=
# access/refresh token은 channel_tokens 서버 전용 테이블에 검수자가 초기 등록합니다.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_LOCATION_ID=
SHOPIFY_ONLINE_STORE_PUBLICATION_ID=
SHOPIFY_PUBLIC_DOMAIN=
CAFE24_PREORDER_LABEL_KEY=
# Shopify가 USD 기준 스토어인 경우, KRW 품목 공급가 환산에 사용합니다.
PRODUCT_REGISTRATION_KRW_PER_USD=
# 검수자가 비상품 이미지 참조까지 확인한 이후에만 전용 테스트 파일 삭제를 허용합니다.
PRODUCT_REGISTRATION_FILE_DELETE_AUDITED=false
# OAuth 토큰 유지와 상품 쓰기는 별도 권한입니다. 검수자만 갱신을 켭니다.
PRODUCT_REGISTRATION_OAUTH_REFRESH_ENABLED=false
# 검수된 모델 가격을 설정하면 토큰 기반 추정 비용을 기록합니다. 미설정이면 null.
PRODUCT_REGISTRATION_INPUT_USD_PER_M_TOKEN=
PRODUCT_REGISTRATION_OUTPUT_USD_PER_M_TOKEN=
